{
  "name": "dsh-workspace-organizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.9.0", "dsh": "0.2.2-rc.5"},
  "exports": {".": "./index.js", "./client": "./client.js", "./package.json": "./package.json"},
  "files": ["index.js", "partitions.js", "opencode.js", "client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml", "listedByDefault": false},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-context-menu", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-connection"]}
  }
}
